# Application
APP_NAME=词元研究所
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
VITE_API_BASE_URL=

# PostgreSQL + pgvector (copy this file to .env and replace placeholders)
POSTGRES_DB=ciyuan
POSTGRES_USER=ciyuan
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ciyuan:replace-with-a-local-password@127.0.0.1:5432/ciyuan?connect_timeout=3

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Model providers: placeholders only; never commit real credentials
# Active provider: Xfyun MaaS hosted DeepSeek-V4-Flash-0731.
XFYUN_MAAS_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
XFYUN_MAAS_API_KEY=
XFYUN_MAAS_MODEL=xopdeepseekv4flash0731
# Optional Python SFT/LoRA model. Leave both blank until the MaaS task has
# passed review, its locked evaluation matches the baseline, and an operator
# explicitly enables the route.
XFYUN_MAAS_PYTHON_TUTOR_ENABLED=false
# Use a separate service key when LoRA authorization differs from the general
# MaaS route. Leave blank only when the general MaaS key is authorized for both.
XFYUN_MAAS_PYTHON_TUTOR_API_KEY=
XFYUN_MAAS_PYTHON_TUTOR_MODEL=
XFYUN_MAAS_PYTHON_TUTOR_LORA_ID=
XFYUN_MAAS_TIMEOUT_SECONDS=45
XFYUN_MAAS_MAX_RETRIES=2
XFYUN_MAAS_MOCK_FALLBACK=true

# Legacy Spark X2-Flash compatibility (optional).
# Keep secrets blank here. Put real values only in the untracked local .env file.
XFYUN_SPARK_BASE_URL=https://spark-api-open.xf-yun.com/agent/v1
XFYUN_SPARK_APP_ID=
# 首选：控制台 HTTP 协议的 APIPassword。也可使用下面的 APIKey + APISecret。
XFYUN_SPARK_API_PASSWORD=
XFYUN_SPARK_API_KEY=
XFYUN_SPARK_API_SECRET=
XFYUN_SPARK_MODEL=spark-x
XFYUN_SPARK_TIMEOUT_SECONDS=30
XFYUN_SPARK_MAX_RETRIES=2
XFYUN_SPARK_MOCK_FALLBACK=true
TUOLING_BASE_URL=replace-with-authorized-api-url
TUOLING_API_KEY=
TUOLING_CONTEXT_PATH=/v1/scenarios/context
TUOLING_TIMEOUT_SECONDS=15
TUOLING_MAX_RETRIES=1
TUOLING_ENABLED=false

# MVP feature switches
RAG_TOP_K=5
RAG_BACKEND=lexical
RAG_MIN_SCORE=0.10
RAG_VECTOR_WEIGHT=0.65
PYTHON_ONLINE_SEARCH_ENABLED=true
PYTHON_DOCS_BASE_URL=https://docs.python.org/zh-cn/3.11/
PYTHON_ONLINE_SEARCH_TIMEOUT_SECONDS=8
PYTHON_ONLINE_SEARCH_MAX_PAGES=2
CODE_EXECUTION_ENABLED=false
