# Leave empty during local development to use the Vite proxy in vite.config.ts.
VITE_API_BASE_URL=
# Abort stalled browser-to-API requests so the demo can recover with a clear message.
VITE_API_TIMEOUT_MS=10000
# MaaS generation can take longer than ordinary API reads; keep this above the backend timeout.
VITE_AI_TIMEOUT_MS=90000
